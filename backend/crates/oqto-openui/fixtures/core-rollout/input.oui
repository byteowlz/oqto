root = Stack([card])
card = Card([head, state, hosts, form])
head = CardHeader("Release 0.5.12", "Pick how to roll it out")
state = Callout("warning", "1 host degraded", "gamma runs 0.5.9 and failed its last health check.")
hosts = Table([Col("Host", ["alpha", "beta", "gamma"]), Col("Runner", ["0.5.11", "0.5.11", "0.5.9"]), Col("State", ["healthy", "healthy", "degraded"])])
form = Form("rollout", btns, [FormControl("Strategy", strategy), FormControl("Note", note, "Shown in the release log")])
strategy = RadioGroup("strategy", [RadioItem("Canary", "One host first, then the rest", "canary"), RadioItem("All at once", "Every host now", "all")], "canary")
note = Input("note", "optional")
btns = Buttons([Button("Roll out", @Answer({strategy: $strategy, note: $note})), Button("Not now", @Answer({cancelled: true}), "secondary")])
