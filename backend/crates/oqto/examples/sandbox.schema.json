{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SandboxConfigFile",
  "description": "Sandbox configuration file structure.\n\nThis is what gets parsed from sandbox.toml. It contains: - Top-level settings (enabled, profile) - Optional custom profile definitions in `[profiles.<name>]`\n\nExample: ```toml enabled = true profile = \"my-custom\"\n\n[profiles.my-custom] deny_read = [\"~/.ssh\", \"~/.gnupg\", \"~/.aws\", \"~/.kube\"] allow_write = [\"~/.cargo\", \"/tmp\"] isolate_network = false isolate_pid = true ```",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "JSON schema reference. Accepted and ignored so editors can validate.",
      "type": [
        "string",
        "null"
      ]
    },
    "allow_read": {
      "description": "Additional paths readable under an allowlist. Unioned with the profile.",
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allow_write": {
      "description": "Additional writable paths. Unioned with the profile.",
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assert_userns_disabled": {
      "description": "Override the assertion that user namespaces are unavailable.",
      "type": [
        "boolean",
        "null"
      ]
    },
    "deny_read": {
      "description": "Additional paths to deny reading. Unioned with the profile.",
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "deny_write": {
      "description": "Additional paths to deny writing. Unioned with the profile.",
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "disable_userns": {
      "description": "Override user-namespace denial.",
      "type": [
        "boolean",
        "null"
      ]
    },
    "drop_all_caps": {
      "description": "Override capability dropping.",
      "type": [
        "boolean",
        "null"
      ]
    },
    "enabled": {
      "description": "Enable sandboxing.",
      "default": false,
      "type": "boolean"
    },
    "extra_ro_bind": {
      "description": "Additional read-only binds. Unioned with the profile.",
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "extra_rw_bind": {
      "description": "Additional read-write binds. Unioned with the profile.",
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "isolate_network": {
      "description": "Override the profile's network isolation.",
      "type": [
        "boolean",
        "null"
      ]
    },
    "isolate_pid": {
      "description": "Override the profile's PID isolation.",
      "type": [
        "boolean",
        "null"
      ]
    },
    "landlock_mode": {
      "description": "Override the Landlock mode.",
      "anyOf": [
        {
          "$ref": "#/definitions/LandlockMode"
        },
        {
          "type": "null"
        }
      ]
    },
    "no_new_privs": {
      "description": "Override no-new-privs.",
      "type": [
        "boolean",
        "null"
      ]
    },
    "overlay_enabled": {
      "description": "Override overlayfs redirection.",
      "type": [
        "boolean",
        "null"
      ]
    },
    "overlay_paths": {
      "description": "Additional overlay targets. Unioned with the profile.",
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "overlay_root": {
      "description": "Override the overlay root directory.",
      "type": [
        "string",
        "null"
      ]
    },
    "profile": {
      "description": "Which profile to use: \"minimal\", \"development\", \"strict\", or a custom name.",
      "default": "",
      "type": "string"
    },
    "profiles": {
      "description": "Custom profile definitions. Keys are profile names, values are profile settings.",
      "default": {},
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/SandboxProfile"
      }
    },
    "read_policy": {
      "description": "Override the read policy for home.",
      "anyOf": [
        {
          "$ref": "#/definitions/ReadPolicy"
        },
        {
          "type": "null"
        }
      ]
    },
    "seccomp_bpf_path": {
      "description": "Override the compiled seccomp policy path.",
      "type": [
        "string",
        "null"
      ]
    },
    "seccomp_mode": {
      "description": "Override the seccomp mode.",
      "anyOf": [
        {
          "$ref": "#/definitions/SeccompMode"
        },
        {
          "type": "null"
        }
      ]
    },
    "ssh": {
      "description": "Grant this work directory the use of specific SSH keys.\n\nWithout this the file fails to parse (unknown field), which silently discards every override in it.",
      "anyOf": [
        {
          "$ref": "#/definitions/SshProxyConfig"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "definitions": {
    "GuardConfig": {
      "description": "Configuration for oqto-guard (FUSE filesystem for runtime access control).",
      "type": "object",
      "properties": {
        "default_on_timeout": {
          "description": "What to do when prompt times out.",
          "default": "prompt",
          "allOf": [
            {
              "$ref": "#/definitions/GuardPolicy"
            }
          ]
        },
        "enabled": {
          "description": "Enable the guard FUSE filesystem.",
          "default": false,
          "type": "boolean"
        },
        "paths": {
          "description": "Paths to expose via the guard (symlinked to FUSE mount). These paths are neither fully blocked nor fully allowed - access is controlled at runtime with user prompts.",
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "policy": {
          "description": "Per-path policy overrides. Keys are glob patterns (e.g., \"~/.kube/*\"), values are policies.",
          "default": {},
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/GuardPolicy"
          }
        },
        "timeout_secs": {
          "description": "Timeout in seconds for user prompts.",
          "default": 60,
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "GuardPolicy": {
      "description": "Policy for guarded path access.",
      "oneOf": [
        {
          "description": "Auto-approve access, but log it.",
          "type": "string",
          "enum": [
            "auto"
          ]
        },
        {
          "description": "Prompt user for approval.",
          "type": "string",
          "enum": [
            "prompt"
          ]
        },
        {
          "description": "Deny access (redundant with deny_read, but explicit).",
          "type": "string",
          "enum": [
            "deny"
          ]
        }
      ]
    },
    "HomeAccess": {
      "description": "Default access to the account home before any rule applies.\n\nThis used to be derived from the profile *name*: `development` and `minimal` got a writable home and every other denylist profile got a read-only one, with nothing in the profile saying so. A profile copied from `development` under another name silently lost write access to home.",
      "oneOf": [
        {
          "description": "Nothing under home is visible unless a rule grants it.",
          "type": "string",
          "enum": [
            "none"
          ]
        },
        {
          "description": "Home is readable; writes need an explicit grant.",
          "type": "string",
          "enum": [
            "read"
          ]
        },
        {
          "description": "Home is writable except where a rule denies it.",
          "type": "string",
          "enum": [
            "write"
          ]
        }
      ]
    },
    "LandlockMode": {
      "description": "Landlock enforcement mode.",
      "type": "string",
      "enum": [
        "off",
        "audit",
        "enforce"
      ]
    },
    "NetworkConfig": {
      "description": "Configuration for network access control. When mode is \"proxy\", traffic goes through eavs with domain filtering.",
      "type": "object",
      "properties": {
        "allow_domains": {
          "description": "Allowed domains when mode is \"proxy\". Used to configure eavs filtering rules.",
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "log_requests": {
          "description": "Log all network requests.",
          "default": false,
          "type": "boolean"
        },
        "mode": {
          "description": "Network access mode.",
          "default": "open",
          "allOf": [
            {
              "$ref": "#/definitions/NetworkMode"
            }
          ]
        },
        "proxy_dns_port": {
          "description": "Host-side port of the DNS resolver for proxy mode. Defaults to `proxy_tcp_port` when unset.",
          "default": null,
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "minimum": 0.0
        },
        "proxy_tcp_port": {
          "description": "Host-side port of the transparent TCP proxy that captures agent egress when mode is \"proxy\". Required for proxy mode (fail-closed if absent).",
          "default": null,
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "NetworkMode": {
      "description": "Network access mode.",
      "oneOf": [
        {
          "description": "No network restrictions.",
          "type": "string",
          "enum": [
            "open"
          ]
        },
        {
          "description": "Full network isolation (bwrap --unshare-net).",
          "type": "string",
          "enum": [
            "isolated"
          ]
        },
        {
          "description": "Network via eavs proxy with domain filtering.",
          "type": "string",
          "enum": [
            "proxy"
          ]
        }
      ]
    },
    "PromptConfig": {
      "description": "Configuration for how prompts are delivered to users.",
      "type": "object",
      "properties": {
        "auto_deny_timeout_secs": {
          "description": "Auto-deny after this many seconds if no response channel available.",
          "default": 30,
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "desktop_notifications": {
          "description": "Enable desktop notifications as fallback when UI not connected.",
          "default": true,
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "ReadPolicy": {
      "description": "How reads under the user's home directory are decided.",
      "oneOf": [
        {
          "description": "Bind the whole home readable, then mask `deny_read`. Any path not enumerated stays readable.",
          "type": "string",
          "enum": [
            "denylist"
          ]
        },
        {
          "description": "Bind nothing under home by default; only `allow_read` (plus the workspace and `allow_write`) is visible.",
          "type": "string",
          "enum": [
            "allowlist"
          ]
        }
      ]
    },
    "ResourceLimits": {
      "description": "Per-process resource limits applied with `setrlimit(2)` immediately before exec.\n\nUnset fields leave the inherited limit untouched. These are per-process and require no cgroup delegation, so they apply unprivileged and when `oqto-sandbox` is used standalone. Placement-level quotas for a whole Workspace remain the supervisor's job (see ADR-0020).\n\nProcess-count caps are deliberately absent: `RLIMIT_NPROC` counts every process of the real UID rather than this sandbox's descendants, so any value below the user's existing process count makes `clone(2)` fail and stops the sandbox from starting at all. Bounding process counts requires cgroup `pids.max`, which belongs to the Placement Supervisor.",
      "type": "object",
      "properties": {
        "max_cpu_seconds": {
          "description": "Maximum CPU time, in seconds (`RLIMIT_CPU`).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "max_file_size_bytes": {
          "description": "Maximum size of any single file written, in bytes (`RLIMIT_FSIZE`).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "max_memory_bytes": {
          "description": "Maximum address space, in bytes (`RLIMIT_AS`).\n\nThis is reserved virtual address space, not resident memory, so it is not a memory budget: JIT and WebAssembly engines reserve far more than they commit and will fail allocation long before the process uses the stated amount. Left unset in the shipped profiles for that reason.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "max_open_files": {
          "description": "Maximum number of open file descriptors (`RLIMIT_NOFILE`).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        }
      }
    },
    "SandboxProfile": {
      "description": "A sandbox profile definition.\n\nProfiles define the security settings for sandboxed processes. Built-in profiles: \"minimal\", \"development\", \"strict\" Custom profiles can be defined in `[profiles.<name>]` sections.\n\n## Security Layers\n\n1. **oqto-sandbox (bwrap)**: Hard deny/allow via namespace isolation 2. **oqto-guard (FUSE)**: Runtime approval for \"gray area\" paths 3. **oqto-ssh-proxy**: SSH access without exposing private keys 4. **Network (eavs)**: Domain-level network filtering",
      "type": "object",
      "properties": {
        "allow_read": {
          "description": "Paths readable under home when `read_policy` is `Allowlist`.",
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allow_write": {
          "description": "Paths to allow write access (in addition to workspace).",
          "default": [
            "~/.cargo",
            "~/.rustup",
            "~/.npm",
            "~/.bun",
            "~/.local/bin",
            "~/.local/share/uv",
            "~/.cache/uv",
            "~/.pi",
            "~/.claude",
            "~/.local/share/claude",
            "~/.cache/claude",
            "~/.codex",
            "~/.local/share/codex",
            "~/.cache/codex",
            "~/.local/share/skdlr",
            "~/.local/share/mmry",
            "~/.local/share/mailz",
            "~/.config/skdlr",
            "~/.config/mmry",
            "~/.config/mailz",
            "~/.config/byt",
            "~/.config/oqto",
            "/tmp"
          ],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "assert_userns_disabled": {
          "description": "Assert that nested user namespaces are disabled (fail if not).",
          "default": false,
          "type": "boolean"
        },
        "deny_read": {
          "description": "Paths to deny read access (always applied).",
          "default": [
            "~/.ssh",
            "/etc/ssh/ssh_config.d",
            "~/.gnupg",
            "~/.aws",
            "/etc/oqto",
            "~/.config/oqto/config.toml",
            "~/.local/share/oqto/credentials",
            "/usr/bin/systemctl",
            "/bin/systemctl",
            "/usr/bin/systemd-run",
            "/bin/systemd-run"
          ],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deny_write": {
          "description": "Paths to deny write access (takes precedence).",
          "default": [
            "~/.config/oqto/sandbox.toml"
          ],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "disable_userns": {
          "description": "Disable nested user namespace creation inside sandbox.",
          "default": true,
          "type": "boolean"
        },
        "drop_all_caps": {
          "description": "Drop all Linux capabilities inside the sandbox.",
          "default": false,
          "type": "boolean"
        },
        "extra_ro_bind": {
          "description": "Additional paths to bind read-only.",
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "extra_rw_bind": {
          "description": "Additional paths to bind read-write.",
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "guard": {
          "description": "Configuration for runtime file access control.",
          "default": null,
          "anyOf": [
            {
              "$ref": "#/definitions/GuardConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "home_access": {
          "description": "Default access to the account home.\n\n`read_policy = \"allowlist\"` masks home regardless, so this applies to denylist profiles. Stated explicitly so writability is a property of the profile rather than of its name.",
          "default": "write",
          "allOf": [
            {
              "$ref": "#/definitions/HomeAccess"
            }
          ]
        },
        "isolate_network": {
          "description": "Whether to isolate network (--unshare-net). Note: If network.mode is \"proxy\", this is handled differently.",
          "default": false,
          "type": "boolean"
        },
        "isolate_pid": {
          "description": "Whether to isolate PID namespace (--unshare-pid).",
          "default": true,
          "type": "boolean"
        },
        "landlock_mode": {
          "description": "Landlock mode (off/audit/enforce).",
          "default": "audit",
          "allOf": [
            {
              "$ref": "#/definitions/LandlockMode"
            }
          ]
        },
        "network": {
          "description": "Configuration for network access control.",
          "default": {
            "allow_domains": [],
            "log_requests": false,
            "mode": "open",
            "proxy_dns_port": null,
            "proxy_tcp_port": null
          },
          "anyOf": [
            {
              "$ref": "#/definitions/NetworkConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "no_new_privs": {
          "description": "Set PR_SET_NO_NEW_PRIVS before exec.",
          "default": true,
          "type": "boolean"
        },
        "overlay_enabled": {
          "description": "Enable overlayfs redirection for selected paths.\n\nWhen enabled, each path in `overlay_paths` is mounted with bwrap overlay so writes go to a per-workspace upperdir under `overlay_root` while reads come from the original path.",
          "default": false,
          "type": "boolean"
        },
        "overlay_paths": {
          "description": "Paths to overlay (typically package/toolchain directories).",
          "default": [
            "~/.cargo",
            "~/.npm",
            "~/.bun",
            "~/.local/share/uv",
            "~/.cache/uv"
          ],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "overlay_root": {
          "description": "Root directory for per-workspace overlay upper/work dirs.\n\nExample: `~/.oqto/overlays`",
          "default": "~/.oqto/overlays",
          "type": "string"
        },
        "prompts": {
          "description": "Configuration for user prompts.",
          "default": {
            "auto_deny_timeout_secs": 30,
            "desktop_notifications": true
          },
          "anyOf": [
            {
              "$ref": "#/definitions/PromptConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "read_policy": {
          "description": "How home-directory reads are decided.",
          "default": "denylist",
          "allOf": [
            {
              "$ref": "#/definitions/ReadPolicy"
            }
          ]
        },
        "resource_limits": {
          "description": "Per-process resource limits applied before exec.",
          "default": {},
          "allOf": [
            {
              "$ref": "#/definitions/ResourceLimits"
            }
          ]
        },
        "scoped_paths": {
          "description": "Dynamic deny+rebind rules evaluated at spawn time.",
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/ScopedPathRule"
          }
        },
        "seccomp_bpf_path": {
          "description": "Path to precompiled seccomp-bpf policy file for bwrap (--seccomp FD).",
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "seccomp_mode": {
          "description": "Seccomp mode (off/audit/enforce).",
          "default": "audit",
          "allOf": [
            {
              "$ref": "#/definitions/SeccompMode"
            }
          ]
        },
        "ssh": {
          "description": "Configuration for SSH agent proxy.",
          "default": {
            "allowed_hosts": [
              "github.com",
              "gitlab.com"
            ],
            "allowed_keys": [],
            "enabled": true,
            "log_connections": true,
            "prompt_unknown": true
          },
          "anyOf": [
            {
              "$ref": "#/definitions/SshProxyConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "workspace_cache_enabled": {
          "description": "Redirect toolchain caches into a per-workspace directory.",
          "default": false,
          "type": "boolean"
        },
        "workspace_cache_root": {
          "description": "Root directory holding per-workspace toolchain caches.",
          "default": "~/.cache/oqto/workspace-caches",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ScopedPathAccess": {
      "type": "string",
      "enum": [
        "ro",
        "rw"
      ]
    },
    "ScopedPathMissing": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "ignore",
            "warn",
            "fail"
          ]
        },
        {
          "description": "Create the target before binding.\n\nRequired for session shards: skipping the bind leaves the base tmpfs in place, so the harness writes its history into the sandbox and loses it on exit with no error anywhere.",
          "type": "string",
          "enum": [
            "create"
          ]
        }
      ]
    },
    "ScopedPathRule": {
      "type": "object",
      "properties": {
        "access": {
          "default": "rw",
          "allOf": [
            {
              "$ref": "#/definitions/ScopedPathAccess"
            }
          ]
        },
        "base_path": {
          "default": "",
          "type": "string"
        },
        "missing": {
          "default": "create",
          "allOf": [
            {
              "$ref": "#/definitions/ScopedPathMissing"
            }
          ]
        },
        "name": {
          "default": "",
          "type": "string"
        },
        "source": {
          "default": "workspace_path",
          "allOf": [
            {
              "$ref": "#/definitions/ScopedPathSource"
            }
          ]
        },
        "source_literal": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "target_template": {
          "default": "{base_path}/{value}",
          "type": "string"
        },
        "transforms": {
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/ScopedPathTransform"
          }
        }
      },
      "additionalProperties": false
    },
    "ScopedPathSource": {
      "type": "string",
      "enum": [
        "workspace_path",
        "literal"
      ]
    },
    "ScopedPathTransform": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "op",
            "value"
          ],
          "properties": {
            "op": {
              "type": "string",
              "enum": [
                "strip_prefix"
              ]
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "from",
            "op",
            "to"
          ],
          "properties": {
            "from": {
              "type": "string"
            },
            "op": {
              "type": "string",
              "enum": [
                "replace"
              ]
            },
            "to": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "op",
            "prefix",
            "suffix"
          ],
          "properties": {
            "op": {
              "type": "string",
              "enum": [
                "wrap"
              ]
            },
            "prefix": {
              "type": "string"
            },
            "suffix": {
              "type": "string"
            }
          }
        }
      ]
    },
    "SeccompMode": {
      "description": "Seccomp enforcement mode.",
      "oneOf": [
        {
          "description": "Disable seccomp integration.",
          "type": "string",
