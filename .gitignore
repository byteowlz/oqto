# Python bytecode is regenerated locally, never implementation source.
__pycache__/
*.py[cod]

# Local binaries / build artifacts
backend/data/home/default/.opencode/bin/opencode
fileserver/target/
nohup.out

# Tauri generated build artifacts (regenerated by tauri build)
frontend/src-tauri/gen/

# User uploads
uploads/
IMG_*.jpeg
IMG_*.png
pasted-image-*.png

# Local reliability test secrets (never commit)
scripts/e2e/.secrets/
*.local.secrets.toml

# Claude Code local config (permissions cache)
.claude/
.mmry/mmry.jsonl
.mmry/index/

# Generated distribution staging; manifest and mutable-template sources stay tracked.
dist/out/
dist/immutable/bin/*
!dist/immutable/bin/.gitkeep

# Defaults are reconstructed from pinned public template/extension sources.
# Ignore the whole generated family, not just extensions, so a public source
# build remains clean after dist-sync and does not falsify release provenance.
dist/immutable/defaults/

# Frontend bundle is built at release time (scripts/dist/stage-frontend.sh).
dist/immutable/frontend/
# Generated from tools/provider-login by scripts/dist/sync.sh.
dist/immutable/provider-login/
# Verified official Pi archives are generated release artifacts.
dist/immutable/pi-runtime/

# Node dependencies (never tracked anywhere)
node_modules/

# trx ledger lives in the central store
/.trx/
