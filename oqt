#!/usr/bin/env bash
# Source-only local DEMO. No installation, ordinary Pi profiles, or stock-tools fallback.
set -euo pipefail
root=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
source=${OQT_PI_SOURCE:-/tmp/oqto-pi-service-spike.PVTso2/source}
workdir=$PWD
mode=demo
owner=${OQT_OWNER_AGENT_DIR:-${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}}
args=()
while (($#)); do
 case "$1" in
  --workdir) workdir=${2:?--workdir needs a directory}; shift 2;;
  --coding) mode=coding; args+=("$1"); shift;;
  --owner-profile) owner=${2:?--owner-profile needs a directory}; shift 2;;
  --demo|--continue|-c|--smoke) args+=("$1"); shift;;
  -h|--help) printf '%s\n' 'oqt: experimental Pi Durable workspace coding' 'Usage: ./oqt --coding [--continue] [--workdir DIR] [--owner-profile DIR]' 'Uses existing owning Pi defaults/credentials read-only. Every tool call crosses protected approval admission; Session approval covers workspace tools.' 'Workspace-only, no network in tools. No skills/codemode/subagents. --demo retains the synthetic demo.' 'The reviewed host is trusted, not an OS-confined untrusted plugin host. Nothing is installed.'; exit 0;;
  *) echo "Unsupported oqt prototype option: $1" >&2; exit 2;;
 esac
done
[[ $(uname -s) == Linux && $(uname -m) == x86_64 ]] || { echo 'Prototype requires Linux x86_64' >&2; exit 2; }
for command in node python3 cargo bwrap taskset nice timeout; do command -v "$command" >/dev/null; done
cpu=$(python3 -c 'import os; print(min(os.sched_getaffinity(0)))')
export CARGO_BUILD_JOBS=1
# Runtime artifacts are local to this worktree, never installed globally.
export CARGO_TARGET_DIR="$root/backend/target"
bounded() { timeout --kill-after=5s 90s taskset -c "$cpu" nice -n 19 "$@"; }
cd "$root"
bpf=$(bounded python3 tools/oqt/build-assets.py "$source")
runtime=$(bounded python3 tools/oqt/prepare.py "$source" "$workdir" "$mode")
value() { python3 -c 'import json,sys; print(json.loads(sys.argv[1])[sys.argv[2]])' "$runtime" "$1"; }
snapshot=$(value source); profile=$(value profile); home=$(value home); agent=$(value agent)
if [[ "$mode" == coding ]]; then
 owner=$(python3 -c 'from pathlib import Path; import sys; print(Path(sys.argv[1]).expanduser().resolve(strict=True))' "$owner")
fi
cd "$workdir"
exec taskset -c "$cpu" nice -n 19 env -i PATH="$PATH" HOME="$home" LANG="${LANG:-C.UTF-8}" \
 TERM="${TERM:-xterm-256color}" COLORTERM="${COLORTERM:-}" \
 NODE_OPTIONS=--max-old-space-size=512 PI_EXPERIMENTAL=1 PI_CODING_AGENT_DIR="$agent" \
 OQT_MODE="$mode" OQT_OWNER_AGENT_DIR="$owner" OQT_RUNTIME_ROOT="$(value runtime_root)" \
 OQT_TRUSTED_SOURCE_ROOT="$root" OQT_SOURCE_CHECKOUT="$source" \
 OQT_SERVER_DIR="$profile" OQT_CARRIER="$(value carrier)" \
 OQT_HANDS="$(value hands)" OQT_BRAIN="$(value brain)" PI_OFFLINE=1 OQT_ENV_DAEMON="$(value daemon)" OQT_SANDBOX_SHIM="$(value shim)" \
 OQT_SECCOMP_BPF="$(value bpf)" OQT_DEBUG="${OQT_DEBUG:-}" \
 node --import "$snapshot/packages/coding-agent/src/experimental/source-resolver.ts" \
 "$snapshot/packages/coding-agent/src/experimental/oqt-launcher.ts" "${args[@]}"
