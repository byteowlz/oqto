# Per-Workspace runner image. Build from the repository root:
# podman build -f deploy/workspace/Containerfile -t localhost/oqto-workspace:dev .
#
# Production components are copied from the staged Oqto bundle or acquired as
# checksum-verified release artifacts. Nothing is compiled in this image.
FROM ubuntu:24.04 AS tools

ARG TARGETARCH
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl tar \
    && rm -rf /var/lib/apt/lists/*
COPY dist/immutable/bin/oqto-setup /usr/local/bin/oqto-setup
COPY dependencies.toml /tmp/dependencies.toml
RUN set -eux; \
    case "$TARGETARCH" in amd64|"") arch=x86-64 ;; arm64) arch=aarch64 ;; *) exit 64 ;; esac; \
    mkdir -p /out/bin /tmp/artifacts; \
    oqto-setup acquire --tools-only --manifest /tmp/dependencies.toml \
      --arch "$arch" --dest /tmp/artifacts --install-bin /out/bin

FROM ubuntu:24.04 AS typst-runtime
ARG TARGETARCH
ARG TYPST_VERSION=0.15.1
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl xz-utils \
    && rm -rf /var/lib/apt/lists/* \
    && case "$TARGETARCH" in \
         amd64|"") target=x86_64-unknown-linux-musl; sha=a6d077d0a95eed5a2eba715b2dae06be954f624ccbf85758a03f389ded33118c ;; \
         arm64) target=aarch64-unknown-linux-musl; sha=5aa8d74a3d906e60ea12a66ac2f37f8eef1b14cbad7182a745e393a10c23dcee ;; \
         *) exit 64 ;; \
       esac \
    && curl -fsSL "https://github.com/typst/typst/releases/download/v${TYPST_VERSION}/typst-${target}.tar.xz" -o /tmp/typst.tar.xz \
    && echo "$sha  /tmp/typst.tar.xz" | sha256sum --check --strict \
    && tar -xJf /tmp/typst.tar.xz --strip-components=1 -C /usr/local/bin "typst-${target}/typst"

FROM ghcr.io/astral-sh/uv:0.11.29 AS uv-runtime

FROM ubuntu:24.04 AS pi-runtime
ARG TARGETARCH
COPY dependencies.toml /tmp/pi-dependencies.toml
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl tar \
    && rm -rf /var/lib/apt/lists/* \
    && version="$(sed -n '/^\[external\]/,/^\[/{s/^pi *= *"\([^"]*\)".*/\1/p}' /tmp/pi-dependencies.toml | head -1)" \
    && case "$TARGETARCH" in \
         amd64|"") asset=pi-linux-x64.tar.gz; key=pi-linux-x64-sha256 ;; \
         arm64) asset=pi-linux-arm64.tar.gz; key=pi-linux-arm64-sha256 ;; \
         *) exit 64 ;; \
       esac \
    && sha="$(sed -n '/^\[external\]/,/^\[/{s/^'"$key"' *= *"\([^"]*\)".*/\1/p}' /tmp/pi-dependencies.toml | head -1)" \
    && test -n "$version" && test -n "$sha" \
    && curl -fsSL --retry 3 \
         "https://github.com/earendil-works/pi/releases/download/v${version}/${asset}" \
         -o /tmp/pi.tar.gz \
    && echo "$sha  /tmp/pi.tar.gz" | sha256sum --check --strict \
    && mkdir -p /out \
    && tar -xzf /tmp/pi.tar.gz -C /tmp \
    && install -m 0755 /tmp/pi/pi /out/pi

FROM node:22-bookworm-slim AS node-runtime

FROM ubuntu:24.04
LABEL org.opencontainers.image.title="oqto-workspace" \
      org.opencontainers.image.description="Isolated Oqto Workspace runner and curated agent toolchain" \
      org.opencontainers.image.source="https://github.com/byteowlz/oqto"

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      bubblewrap ca-certificates coreutils curl findutils git jq openssh-client procps python3 \
      python3-venv ripgrep tini tmux ttyd unzip xz-utils \
    && rm -rf /var/lib/apt/lists/* \
    && if id ubuntu >/dev/null 2>&1; then userdel --remove ubuntu; fi
RUN if getent group ubuntu >/dev/null 2>&1; then groupdel ubuntu; fi \
    && groupadd --gid 1000 oqto \
    && useradd --uid 1000 --gid 1000 --create-home --shell /bin/bash oqto

# Pi is the official checksummed standalone Bun executable. Node remains for
# workspace tools, but Pi no longer depends on host npm resolution.
COPY --from=pi-runtime /out/pi /usr/local/bin/pi
COPY --from=node-runtime /usr/local/bin/node /usr/local/bin/node

COPY --from=tools /out/bin/ /usr/local/bin/
COPY --from=typst-runtime /usr/local/bin/typst /usr/local/bin/typst
COPY --from=uv-runtime /uv /uvx /usr/local/bin/
COPY dist/immutable/bin/oqto-runner /usr/local/bin/oqto-runner
COPY dist/immutable/bin/oqto-sandbox /usr/local/bin/oqto-sandbox
COPY dist/immutable/bin/oqto-files /usr/local/bin/oqto-files
COPY dist/immutable/seccomp/default.bpf /usr/local/share/oqto/seccomp/default.bpf
COPY deploy/workspace/sandbox.toml /etc/oqto/sandbox.toml
# Same upload-limit template as host deployments; baked because container
# /etc is immutable. Keep aligned with [server].max_upload_size_mb.
COPY dist/mutable-templates/etc/oqto/files.toml /etc/oqto/files.toml
COPY deploy/workspace/entrypoint.sh /usr/local/bin/oqto-workspace-entrypoint

RUN chmod 0755 /usr/local/bin/pi /usr/local/bin/oqto-workspace-entrypoint \
    && mkdir -p /workspace /run/oqto \
    && chown -R 1000:1000 /workspace /run/oqto /home/oqto

ENV HOME=/home/oqto \
    USER=oqto \
    PATH=/usr/local/bin:/usr/bin:/bin:/home/oqto/.local/bin:/home/oqto/.cargo/bin
WORKDIR /workspace
USER 1000:1000
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/oqto-workspace-entrypoint"]
CMD ["oqto-runner", "--socket", "/run/oqto/runner.sock"]
