[Unit]
Description=Oqto headless user runner

[Service]
Type=notify
ExecStart=/usr/local/bin/oqto-runner --socket %t/oqto-runner.sock
Restart=on-failure
RestartSec=5
# Each client connection and Pi session holds descriptors; the 1024 default
# was exhausted in production (trx-4s8v).
LimitNOFILE=65536
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=%h %t /tmp

[Install]
WantedBy=default.target
