{
	"$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
	"formatter": {
		"enabled": true
	},
	"organizeImports": {
		"enabled": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		}
	},
	"overrides": [
		{
			"include": ["src/generated/**"],
			"organizeImports": { "enabled": false }
		}
	],
	"files": {
		"ignore": [
			".next",
			"dist",
			"node_modules",
			"public/visual-runtime/vendor",
			"src-tauri/gen",
			"src-tauri/target",
			"vendor"
		]
	}
}
